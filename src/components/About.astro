---
const stats = [
  { value: '50+', label: 'Live Shows' },
  { value: '6', label: 'Years on Stage' },
  { value: '80+', label: 'Songs in Setlist' },
  { value: '5★', label: 'Client Rating' },
];

import bandpic2 from '../assets/img/about/neonpulse-about1.jpg';  
---

<section id="about" class="relative py-24 md:py-32 overflow-hidden">
  <div class="absolute inset-0 bg-grid opacity-20"></div>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-150 h-150 bg-neon-magenta/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <div class="reveal">
        <span class="inline-block px-3 py-1 rounded-full bg-neon-blue/10 border border-neon-blue/30 text-neon-blue text-xs font-semibold tracking-wider uppercase mb-4">
          About the Band
        </span>
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-black mb-6 leading-tight">
          We don't just play the songs.
          <span class="text-gradient block">We bring the party!</span>
        </h2>
        <p class="text-lg text-gray-400 mb-6 leading-relaxed">
         Born in Droitwich Spa in 2020, Neon Pulse began with three musicians who met at a karaoke night and decided an 80s-inspired synth-pop trio might be a rather good idea.
        </p>
        <p class="text-lg text-gray-400 mb-8 leading-relaxed">
          Six years on, Neon Pulse has evolved into a high-energy live party band with a repertoire of more than 80 songs spanning the 80s and 90s.
        </p>
        <p class="text-lg text-gray-400 mb-8 leading-relaxed">
          Pete and Vanessa lead the vocals and live performance, while Nik brings the synths, keyboards, arrangements, sound design and bespoke programmed backing sequences together on stage.
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          {stats.map((stat) => (
            <div class="neon-border rounded-2xl p-4 bg-dark-800/50 backdrop-blur-sm">
              <div class="text-3xl md:text-4xl font-black text-gradient">{stat.value}</div>
              <div class="text-xs text-gray-400 uppercase tracking-wider mt-1">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>

      <div class="reveal reveal-delay-2 relative">
        <div class="relative aspect-4/5 rounded-3xl overflow-hidden neon-border">
          <img
            src={bandpic2.src}
            alt="Neon Pulse performing live on stage"
            class="w-full h-full object-cover"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-linear-to-t from-dark-900 via-transparent to-transparent"></div>
          <div class="absolute bottom-6 left-6 right-6">
            <div class="flex items-center gap-3 text-white">
              <div class="w-12 h-12 rounded-full bg-linear-to-br from-neon-blue to-neon-magenta flex items-center justify-center">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
                </svg>
              </div>
              <div>
                <div class="font-bold">Live since 2020</div>
                <div class="text-sm text-gray-300">Droitwich Spa, UK</div>
              </div>
            </div>
          </div>
        </div>
        <!-- Floating badge -->
        <div class="absolute -top-4 -right-4 md:top-8 md:-right-8 bg-linear-to-br from-neon-amber to-neon-magenta text-dark-900 rounded-2xl p-4 rotate-6 shadow-2xl">
          <div class="text-3xl font-black">6+</div>
          <div class="text-xs font-bold uppercase">Years</div>
        </div>
      </div>
    </div>
  </div>
</section>