---
const GIGS_ENDPOINT =
  "https://opensheet.elk.sh/1m20NyTFPoSQXXfzojceNyghC_YwnC8GzHfMCB7Wtbr8/upcoming-gigs";

let gigs = [];

try {
  const res = await fetch(GIGS_ENDPOINT);

  if (res.ok) {
    const data = await res.json();

    gigs = data.map((gig: any) => ({
      date: gig.Date,
      venue: gig.Venue,
      city: gig.City,
      country: gig.Country,
      time: gig.Time,
      ticketUrl: gig.TicketURL,
      poster: gig.Poster,
      status: gig.Status.toLowerCase(),
      featured: gig.Featured === "TRUE",
    }));
  }
} catch (err) {
  console.error(err);
}

const formatDate = (iso: string) => {
  const d = new Date(`${iso}T12:00:00`);

  return {
    day: d.toLocaleDateString("en-GB", { day: "2-digit" }),
    month: d.toLocaleDateString("en-GB", { month: "short" }).toUpperCase(),
    weekday: d.toLocaleDateString("en-GB", { weekday: "long" }),
    year: d.getFullYear(),
  };
};
---


<section id="gigs" class="relative py-24 md:py-32 overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-dark-900 via-dark-800/30 to-dark-900"></div>
  <div class="absolute top-1/2 left-0 w-96 h-96 bg-neon-blue/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/3 right-0 w-96 h-96 bg-neon-magenta/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16 reveal">
      <span class="inline-block px-3 py-1 rounded-full bg-neon-amber/10 border border-neon-amber/30 text-neon-amber text-xs font-semibold tracking-wider uppercase mb-4">
        On Tour
      </span>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-black mb-4">
        Upcoming <span class="text-gradient-amber">Gigs</span>
      </h2>
      <p class="text-gray-400 max-w-2xl mx-auto">
        Catch us live across the UK. Tickets selling fast — don't miss out.
      </p>
    </div>

    <div class="space-y-3">
      {gigs.length === 0 ? (
        <div class="text-center py-16 text-gray-500 reveal">
          <p class="text-lg">No upcoming gigs announced yet.</p>
          <p class="text-sm mt-2">Check back soon or <a href="#contact" class="text-neon-blue hover:underline">book us for your event</a>.</p>
        </div>
      ) : (
        gigs.map((gig) => {
          const date = formatDate(gig.date);
          return (
            <article
              class="reveal group relative rounded-2xl border border-white/10 bg-dark-800/40 backdrop-blur-sm hover:border-neon-blue/40 hover:bg-dark-700/60 transition-all overflow-hidden"
            >
              <div class="flex flex-col sm:flex-row items-stretch">
                {/* Date badge */}
                <div class="sm:w-32 flex sm:flex-col items-center justify-center p-4 sm:p-6 bg-gradient-to-br from-neon-blue/10 to-neon-magenta/10 border-b sm:border-b-0 sm:border-r border-white/5">
                  <div class="text-xs text-neon-blue font-bold tracking-wider">{date.month}</div>
                  <div class="text-4xl md:text-5xl font-black text-white leading-none my-1">{date.day}</div>
                  <div class="text-xs text-gray-400">{date.weekday}</div>
                </div>

                {/* Details */}
                <div class="flex-1 p-5 sm:p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                  <div class="flex-1 min-w-0">
                    <h3 class="text-xl md:text-2xl font-bold text-white truncate group-hover:text-neon-blue transition-colors">
                      {gig.venue}
                    </h3>
                    <p class="text-gray-400 text-sm md:text-base mt-1">
                      {gig.city}{gig.country ? `, ${gig.country}` : ''}
                      <span class="mx-2 text-gray-600">•</span>
                      <span class="text-neon-amber">Doors {gig.time}</span>
                    </p>
                  </div>

                  <div class="flex items-center gap-3">
                    {gig.soldOut ? (
                      <span class="px-5 py-2.5 rounded-full border border-gray-600 text-gray-500 text-sm font-semibold cursor-not-allowed">
                        Sold Out
                      </span>
                    ) : gig.ticketsUrl ? (
                      <a
                        href={gig.ticketsUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-gradient-to-r from-neon-blue to-neon-magenta text-white text-sm font-semibold hover:shadow-[0_0_25px_rgba(0,212,255,0.5)] transition-all hover:scale-105"
                      >
                        Tickets
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                      </a>
                    ) : (
                      <span class="px-5 py-2.5 rounded-full border border-neon-amber/40 text-neon-amber text-sm font-semibold">
                        Free Entry
                      </span>
                    )}
                  </div>
                </div>
              </div>

              {/* Hover glow */}
              <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none bg-gradient-to-r from-neon-blue/5 via-transparent to-neon-magenta/5"></div>
            </article>
          );
        })
      )}
    </div>

    <div class="text-center mt-12 reveal">
      <p class="text-sm text-gray-500">
        Want us at your venue?{' '}
        <a href="#contact" class="text-neon-blue hover:underline font-semibold">Get in touch →</a>
      </p>
    </div>
  </div>
</section>