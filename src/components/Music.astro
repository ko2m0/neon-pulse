---
// Replace with your actual Spotify artist/playlist embed URL
const spotifyEmbedUrl = 'https://open.spotify.com/embed/playlist/37i9dQZF1DXcBWIGoYBM5M?utm_source=generator&theme=0';
---

<section id="music" class="relative py-24 md:py-32 bg-dark-800/50">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12 reveal">
      <span class="inline-block px-3 py-1 rounded-full bg-neon-blue/10 border border-neon-blue/30 text-neon-blue text-xs font-semibold tracking-wider uppercase mb-4">
        Listen Now
      </span>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-black mb-4">
        Our <span class="text-gradient">Sound</span>
      </h2>
      <p class="text-gray-400 max-w-2xl mx-auto">
        Dive into our latest setlist. From classic rock anthems to modern pop bangers.
      </p>
    </div>

    <div class="reveal reveal-delay-1 grid md:grid-cols-2 gap-6">
      <div class="neon-border rounded-3xl overflow-hidden bg-dark-900">
        <iframe
          src={spotifyEmbedUrl}
          title="Neon Pulse Spotify Playlist"
          width="100%"
          height="380"
          loading="lazy"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          class="w-full"
        ></iframe>
      </div>

      <div class="neon-border rounded-3xl p-8 bg-gradient-to-br from-dark-800 to-dark-900 flex flex-col justify-between">
        <div>
          <h3 class="text-2xl md:text-3xl font-bold mb-4">
            Stream us on <span class="text-gradient">Spotify</span>
          </h3>
          <p class="text-gray-400 mb-8">
            Follow our official playlist to hear the tracks we're spinning at every show.
            Updated monthly with fresh additions from the latest tours.
          </p>

          <div class="space-y-3 mb-8">
            {['Rock Anthems (80s–Now)', 'Pop Classics & Chart Hits', 'Indie Favourites', 'Power Ballads'].map((item, i) => (
              <div class="flex items-center gap-3 text-gray-300">
                <span class="w-8 h-8 rounded-lg bg-gradient-to-br from-neon-blue/20 to-neon-magenta/20 border border-white/10 flex items-center justify-center text-neon-blue text-sm font-bold">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span>{item}</span>
              </div>
            ))}
          </div>
        </div>

        <a
          href="https://open.spotify.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-3 px-6 py-3 rounded-full bg-[#1DB954] text-white font-bold hover:bg-[#1ed760] hover:scale-105 transition-all"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
          </svg>
          Open in Spotify
        </a>
      </div>
    </div>
  </div>
</section>