---
const services = [
  { icon: '', label: 'Weddings' },
  { icon: '🎸', label: 'Festivals' },
  { icon: '🏢', label: 'Corporate' },
  { icon: '🎉', label: 'Private Parties' },
];
---

<section id="contact" class="relative py-24 md:py-32 overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-dark-900 via-dark-800/50 to-dark-900"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-neon-blue/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16 reveal">
      <span class="inline-block px-3 py-1 rounded-full bg-neon-amber/10 border border-neon-amber/30 text-neon-amber text-xs font-semibold tracking-wider uppercase mb-4">
        Get in Touch
      </span>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-black mb-4">
        Book <span class="text-gradient-amber">Neon Pulse</span>
      </h2>
      <p class="text-gray-400 max-w-2xl mx-auto">
        Tell us about your event. We'll get back to you within 24 hours with availability and a custom quote.
      </p>
    </div>

    <div class="grid lg:grid-cols-5 gap-8">
      {/* Info column */}
      <div class="lg:col-span-2 reveal">
        <div class="neon-border rounded-3xl p-8 bg-dark-800/40 backdrop-blur-sm h-full">
          <h3 class="text-2xl font-bold mb-6">Why choose us?</h3>
          <ul class="space-y-4 mb-8">
            {[
              'Professional 5-piece lineup',
              'Full PA & lighting included',
              'Flexible setlists — you choose the vibe',
              'Public liability insurance',
              'PAT-tested equipment',
            ].map((item) => (
              <li class="flex items-start gap-3 text-gray-300">
                <svg class="w-5 h-5 text-neon-blue flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <div class="pt-6 border-t border-white/10">
            <div class="text-xs text-gray-500 uppercase tracking-wider mb-3">Available for</div>
            <div class="grid grid-cols-2 gap-2">
              {services.map((s) => (
                <div class="flex items-center gap-2 text-sm text-gray-300">
                  <span class="text-lg">{s.icon}</span>
                  <span>{s.label}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      {/* Form column */}
      <div class="lg:col-span-3 reveal reveal-delay-1">
        <form
          id="contact-form"
          class="neon-border rounded-3xl p-6 md:p-8 bg-dark-800/40 backdrop-blur-sm space-y-5"
          novalidate
        >
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-sm font-medium text-gray-300 mb-2">Your Name *</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 rounded-xl bg-dark-900/60 border border-white/10 text-white placeholder-gray-500 focus:border-neon-blue focus:outline-none focus:ring-2 focus:ring-neon-blue/20 transition-all"
                placeholder="Jane Smith"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-gray-300 mb-2">Email *</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 rounded-xl bg-dark-900/60 border border-white/10 text-white placeholder-gray-500 focus:border-neon-blue focus:outline-none focus:ring-2 focus:ring-neon-blue/20 transition-all"
                placeholder="jane@example.com"
              />
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="date" class="block text-sm font-medium text-gray-300 mb-2">Event Date</label>
              <input
                type="date"
                id="date"
                name="date"
                class="w-full px-4 py-3 rounded-xl bg-dark-900/60 border border-white/10 text-white focus:border-neon-blue focus:outline-none focus:ring-2 focus:ring-neon-blue/20 transition-all"
              />
            </div>
            <div>
              <label for="type" class="block text-sm font-medium text-gray-300 mb-2">Event Type</label>
              <select
                id="type"
                name="type"
                class="w-full px-4 py-3 rounded-xl bg-dark-900/60 border border-white/10 text-white focus:border-neon-blue focus:outline-none focus:ring-2 focus:ring-neon-blue/20 transition-all"
              >
                <option value="">Select...</option>
                <option>Wedding</option>
                <option>Festival</option>
                <option>Corporate Event</option>
                <option>Private Party</option>
                <option>Other</option>
              </select>
            </div>
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-gray-300 mb-2">Tell us about your event *</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="w-full px-4 py-3 rounded-xl bg-dark-900/60 border border-white/10 text-white placeholder-gray-500 focus:border-neon-blue focus:outline-none focus:ring-2 focus:ring-neon-blue/20 transition-all resize-none"
              placeholder="Venue, guest count, vibe you're after..."
            ></textarea>
          </div>

          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-2">
            <p class="text-xs text-gray-500">* Required fields. We'll never share your details.</p>
            <button
              type="submit"
              class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-gradient-to-r from-neon-blue to-neon-magenta text-white font-bold hover:shadow-[0_0_30px_rgba(0,212,255,0.5)] transition-all hover:scale-105"
            >
              Send Enquiry
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
          </div>

          <div id="form-status" class="hidden text-sm text-center py-3 rounded-xl"></div>
        </form>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('contact-form');
    const status = document.getElementById('form-status');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!status) return;
      status.classList.remove('hidden', 'text-green-400', 'text-red-400');
      status.classList.add('text-neon-blue');
      status.textContent = 'Sending...';

      // Simulated submission — replace with your endpoint
      await new Promise((r) => setTimeout(r, 900));

      status.classList.remove('text-neon-blue');
      status.classList.add('text-green-400', 'bg-green-500/10');
      status.textContent = '✓ Thanks! We\'ll be in touch within 24 hours.';
      form.reset();

      setTimeout(() => status.classList.add('hidden'), 5000);
    });
  </script>
</section>