---
const response = await fetch(
  "https://opensheet.elk.sh/1m20NyTFPoSQXXfzojceNyghC_YwnC8GzHfMCB7Wtbr8/upcoming-gigs"
);

const gigs = await response.json();

import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Video from '../components/Video.astro';
import Gigs from '../components/Gigs.astro';
import Music from '../components/Music.astro';
import Gallery from '../components/Gallery.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Neon Pulse — UK Rock & Pop Covers Band | Live Music for Every Occasion"
  description="Neon Pulse is the UK's premier rock & pop covers band. High-energy live performances for festivals, weddings, corporate events and private parties. Book now."
>
  <Nav />
  <main>
    <Hero />
    <About />
    <Video />
    <Gigs />
    <Music />
    <Gallery />
    <SocialLinks />
    <Contact />
  </main>
  <Footer />
</Layout>