---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Hero from '../components/nik/Hero.astro'
import About from '../components/nik/About.astro'
import OriginalMusic from '../components/nik/OriginalMusic.astro'
import NikLiveFestivals from '../components/nik/LiveFestivals.astro';
import NikMusicLinks from '../components/nik/MusicLinks.astro';
import NikContact from '../components/nik/Contact.astro';
import BackToNeonPulse from '../components/nik/BackToNeonPulse.astro';
import Footer from '../components/Footer.astro';

import { nikNavLinks } from '../data/nik-links'

const title = "Nik Owen Jones | Electronic Music & Live Performance";
const description =
  "Nik Owen Jones — electronic music producer, keyboardist and live performer.";
---
<Layout
  title="Nik Owen Jones"
  description="Nik Owen Jones">

<Nav
variant="nik"
    links={nikNavLinks}
    ctaLabel="Listen"
    ctaHref="#listen"
     />
<main class="overflow-x-hidden">
  <!-- Hero -->
<Hero />
<About />
<OriginalMusic />
<NikLiveFestivals />
<NikMusicLinks />
<NikContact />
<BackToNeonPulse />
  <!-- About -->
  <!-- Music -->
  <!-- Live -->
  <!-- Contact -->
</main> 
<Footer />
</Layout>
